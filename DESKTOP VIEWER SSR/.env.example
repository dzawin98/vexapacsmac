VITE_DICOMWEB_BASE_URL=http://127.0.0.1:5001/rs
VITE_DICOMWEB_AUTHORIZATION=
VITE_DICOMWEB_QIDO_PREFIX=
VITE_DICOMWEB_WADO_PREFIX=
VITE_DICOMWEB_STOW_PREFIX=

# Cornerstone loading performance (desktop viewer)
# Cache defaults adapt to browser device memory when this is left empty.
VITE_CORNERSTONE_CACHE_MB=
VITE_CORNERSTONE_INTERACTION_REQUESTS=6
VITE_CORNERSTONE_THUMBNAIL_REQUESTS=4
VITE_CORNERSTONE_PREFETCH_REQUESTS=3
VITE_CORNERSTONE_COMPUTE_REQUESTS=2
VITE_STACK_SCROLL_PREFETCH_RADIUS=8

# Enable only after the DICOMweb server is verified to support the feature.
VITE_DICOM_PROGRESSIVE_STREAMING=false
VITE_DICOM_PROGRESSIVE_BYTE_RANGE=false

# Nama baru; nama lama NEXIA_RIS_SHARED_SECRET tetap dibaca untuk kompatibilitas.
VEXA_RIS_SHARED_SECRET=Velodesktopview89287579@#$$@
NEXIA_RIS_SHARED_SECRET=Velodesktopview89287579@#$$@
NEXIA_RIS_HEADER_NAME=RIS-Desktop-Sec
NEXIA_SESSION_COOKIE_NAME=vexa_desktop_session
NEXIA_RIS_CONSUME_REDIRECT_PATH=/view

# Hybrid server-rendered MPR limits
MPR_VOLUME_LOAD_CONCURRENCY=4
MPR_ISOTROPIC_RESAMPLE_MAX_VOXELS=67108864
MPR_FRAME_CACHE_MB=512

# Alternative via RIS backend proxy:
# VITE_DICOMWEB_BASE_URL=http://localhost:3001/dicom-web

# Production example:
# VITE_DICOMWEB_BASE_URL=https://pacs.domain.com/rs
# VITE_DICOMWEB_AUTHORIZATION=Bearer replace-with-token
