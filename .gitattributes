# Normalisasi akhir baris: repo ini dijalankan di macOS (LF),
# sementara skrip Windows (.bat/.ps1) tetap CRLF.
* text=auto eol=lf

*.sh            text eol=lf
*.command       text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.py            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yml.example   text eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.wasm          binary
*.ico           binary
*.pdf           binary
*.lockb         binary
