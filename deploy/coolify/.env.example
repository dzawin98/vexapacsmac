# This file is only for local Compose validation. Coolify exposes the same
# variables in its UI and generates SERVICE_PASSWORD_* values itself.
VEXA_DATA_ROOT=/data/vexa-test
VEXA_LICENSE_ENFORCE=false
PACS_AE_TITLE=VEXATEST
PACS_DIMSE_PORT=5757
PACS_PERMISSIVE_MODE=true

# Stand-ins used only when validating the compose stack outside Coolify.
SERVICE_PASSWORD_64_POSTGRES=replace-with-a-long-test-password
SERVICE_PASSWORD_64_DESKTOP_RIS=replace-with-a-long-desktop-secret
SERVICE_PASSWORD_64_MOBILE_RIS=replace-with-a-long-mobile-secret
SERVICE_URL_RIS-WEB_80=http://localhost:8080
SERVICE_URL_DESKTOP-VIEWER_5991=http://localhost:5991
SERVICE_URL_MOBILE-VIEWER_5992=http://localhost:5992
SERVICE_URL_ECG-VIEWER_7771=http://localhost:7771
